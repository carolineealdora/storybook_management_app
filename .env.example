# Copy to .env and fill in. Never commit .env.
ENV=development
PORT=9999
LOG_LEVEL=INFO

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=<redacted>
DB_NAME=storybook
DB_SSL_MODE=disable
DB_TIMEZONE=UTC

# Required, >= 32 chars. Generate: openssl rand -base64 48
# Use a different value from storybook_library_app (ADR-011).
JWT_SECRET=<redacted>
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=168h
# Empty = same-origin only. The back office calls /api through the Vite proxy (dev, :3000) or
# nginx (production), so it needs no CORS. List origins (comma separated) only for a frontend
# served from another origin.
CORS_ALLOW_ORIGINS=

# Mocked accounts created by `make seed` (PRD: no sign-up)
SEED_PARENT_NAME=Demo Parent
SEED_PARENT_EMAIL=parent@example.com
SEED_PARENT_PASSWORD=<redacted>
SEED_ADMIN_NAME=Demo Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=<redacted>
SEED_PLAN_PRICE=49000
SEED_PLAN_BENEFITS=Read all published books.
